---
import { testimonials } from '../config/content';
---

<section id="depoimentos" class="bg-forest text-white py-28">
  <div class="max-w-6xl mx-auto px-8">

    <!-- Título -->
    <div class="text-center mb-20">
      <h2 class="font-serif text-5xl md:text-6xl font-light">
        {testimonials.title}
      </h2>
      <!-- Linha decorativa -->
      <div class="mt-5 mx-auto w-56 h-px bg-white/40"></div>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-12 md:gap-16">
      {testimonials.items.map(item => (
        <div class="flex flex-col text-center">
          <!-- Frase de destaque -->
          <p class="font-serif italic text-xl md:text-2xl leading-snug mb-8 text-white/95">
            "{item.quote}"
          </p>

          <!-- Divisor -->
          <hr class="border-white/25 mb-8" />

          <!-- Texto completo -->
          <p class="text-sm leading-7 text-white/75 flex-1 mb-8">
            {item.body}
          </p>

          <!-- Autor -->
          <p class="text-xs tracking-widest uppercase text-white/50">
            {item.author}, {item.role}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
