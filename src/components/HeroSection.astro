---
import { hero } from '../config/content';
---

<section id="inicio" class="relative h-screen overflow-hidden">
  <!-- Foto de fundo -->
  <img
    src={hero.image}
    alt={hero.imageAlt}
    class="absolute inset-0 w-full h-full object-cover object-center"
  />
  <!-- Gradiente escuro na parte inferior -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/15 to-black/55"></div>

  <!-- Texto centralizado na parte inferior -->
  <div class="relative z-10 flex flex-col items-center justify-end h-full pb-28 text-white text-center px-6">
    <h1 class="font-serif text-7xl md:text-8xl lg:text-9xl font-light tracking-wide leading-none">
      {hero.name}
    </h1>
    <p class="text-lg md:text-xl mt-4 font-light tracking-[0.3em] uppercase">
      {hero.tagline}
    </p>
  </div>
</section>
