---
import { contact } from '../config/content';

// Separa o headline em duas partes: antes e depois da palavra destacada
const words = contact.headline.split(' ');
const highlightIdx = words.findIndex(w =>
  w.toLowerCase().includes(contact.highlightWord.toLowerCase().replace('.', ''))
);
const before = words.slice(0, highlightIdx).join(' ');
const highlighted = words[highlightIdx];
const after = words.slice(highlightIdx + 1).join(' ');
---

<section id="contato" class="bg-terra text-white">
  <div class="max-w-6xl mx-auto px-8 py-28 grid md:grid-cols-2 gap-20 items-center">

    <!-- Coluna esquerda: Headline + Redes sociais -->
    <div class="reveal">
      <h2 class="font-serif text-4xl md:text-5xl lg:text-6xl font-light leading-tight mb-10">
        {before}
        <!-- Palavra com destaque oval -->
        <span class="relative inline-block mx-1">
          <span class="relative z-10">{highlighted}</span>
          <svg
            class="absolute -inset-x-4 -inset-y-2 w-[calc(100%+2rem)] h-[calc(100%+1rem)]"
            viewBox="0 0 120 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="none"
          >
            <ellipse
              cx="60" cy="20" rx="58" ry="17"
              stroke="white"
              stroke-width="1.5"
            />
          </svg>
        </span>
        {after && ` ${after}`}
      </h2>

      <!-- Divisor -->
      <hr class="border-white/30 w-2/3 mb-8" />

      <!-- Redes sociais -->
      <p class="text-xs tracking-widest uppercase text-white/60 mb-5">
        {contact.social.label}
      </p>

      <div class="flex items-center gap-5">
        <!-- Facebook -->
        <a href={contact.social.facebook} aria-label="Facebook" class="hover:opacity-60 transition-opacity">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>

        <!-- Instagram -->
        <a href={contact.social.instagram} aria-label="Instagram" class="hover:opacity-60 transition-opacity">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>

        <!-- TikTok -->
        <a href={contact.social.tiktok} aria-label="TikTok" class="hover:opacity-60 transition-opacity">
          <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.76a4.85 4.85 0 01-1.01-.07z"/>
          </svg>
        </a>

        <span class="ml-1 text-sm font-light">{contact.social.handle}</span>
      </div>
    </div>

    <!-- Coluna direita: Telefone -->
    <div class="flex md:justify-end reveal" style="transition-delay: 0.2s">
      <div class="flex items-center gap-5">
        <div class="w-14 h-14 rounded-full border border-white/40 flex items-center justify-center flex-shrink-0">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>
        <div>
          <p class="text-xs tracking-widest uppercase text-white/55 mb-1">
            {contact.phone.label}
          </p>
          <p class="text-lg font-light tracking-wide">{contact.phone.number}</p>
        </div>
      </div>
    </div>

  </div>
</section>
